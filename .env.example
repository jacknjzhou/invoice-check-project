# PostgreSQL 配置
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=invoice_agent

# 后端配置
DATA_DIR=/app/data
CORS_ORIGINS=http://localhost,http://localhost:80

# LLM 配置（可选）
# 容器内运行时默认会自动连接 http://host.docker.internal:11434/v1（宿主机 Ollama）
# 宿主机本地运行时默认会自动连接 http://localhost:11434/v1
# 如需自定义地址，可通过环境变量覆盖：
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# 如果需要自定义端口，可以修改 docker-compose.yml 中的端口映射
